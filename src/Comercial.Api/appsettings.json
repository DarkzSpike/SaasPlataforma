{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Database": { "Provider": "Postgres" },
  "Jwt": { "TenantAccessMinutes": 10, "AdminAccessMinutes": 15, "RefreshDays": 30 },
  "License": { "OfflineValidityHours": 72 },
  "Security": { "MaxFailedLogins": 5, "LockoutMinutes": 15 },
  "RateLimit": { "AuthPerMinute": 10, "GlobalPerMinute": 600 }
}
