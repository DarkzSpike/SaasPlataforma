<Application x:Class="Comercial.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop"
             xmlns:views="clr-namespace:Comercial.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type local:LoginViewModel}"><views:LoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:ShellViewModel}"><views:ShellView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:PosViewModel}"><views:PosView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:HistoryViewModel}"><views:HistoryView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:ProfitViewModel}"><views:ProfitView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:StockViewModel}"><views:StockView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:CashHistoryViewModel}"><views:CashView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
