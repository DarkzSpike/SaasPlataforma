<Application x:Class="Comercial.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop"
             xmlns:views="clr-namespace:Comercial.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type local:LoginViewModel}"><views:LoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:ShellViewModel}"><views:ShellView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:PosViewModel}"><views:PosView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:DashboardViewModel}"><views:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:HistoryViewModel}"><views:HistoryView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:ProfitViewModel}"><views:ProfitView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:StockViewModel}"><views:StockView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:CashHistoryViewModel}"><views:CashView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:PurchasesViewModel}"><views:PurchasesView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:CustomersViewModel}"><views:CustomersView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:FinanceViewModel}"><views:FinanceView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:PendingViewModel}"><views:PendingView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:AlertsViewModel}"><views:AlertsView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:InvoicesViewModel}"><views:InvoicesView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:SupportViewModel}"><views:SupportView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:EmployeesViewModel}"><views:EmployeesView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:StorePaymentsViewModel}"><views:StorePaymentsView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:FiscalViewModel}"><views:FiscalView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:DevicesViewModel}"><views:DevicesView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:AccountViewModel}"><views:AccountView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:HelpViewModel}"><views:HelpView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:PromotionsViewModel}"><views:PromotionsView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:QuotesViewModel}"><views:QuotesView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:ReportsViewModel}"><views:ReportsView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:SettingsViewModel}"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type local:CampaignsViewModel}"><views:CampaignsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
