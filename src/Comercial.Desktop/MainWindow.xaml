<Window x:Class="Comercial.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SystemName}" Width="1480" Height="920" MinWidth="1200" MinHeight="760"
        Icon="{DynamicResource WindowIcon}" WindowStartupLocation="CenterScreen" WindowState="Maximized" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource BgBrush}">
    <Grid>
        <ContentControl Content="{Binding Current}" Focusable="False"/>
        <!-- Botão flutuante do WhatsApp de atendimento (número configurado no painel admin) -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,38" Width="52" Height="52" Cursor="Hand" Focusable="False"
                Command="{Binding WhatsappCommand}" ToolTip="{Binding WhatsappTip}" AutomationProperties.Name="Falar com o suporte no WhatsApp"
                Visibility="{Binding HasWhatsapp, Converter={StaticResource Vis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="#25D366">
                            <Ellipse.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="#000000"/></Ellipse.Effect>
                        </Ellipse>
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- balão com "rabinho" no canto inferior esquerdo -->
                                <Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      Data="M 3.6,20.4 L 4.8,16.3 A 8.6,8.6 0 1 1 7.9,19.3 Z"/>
                                <!-- telefone -->
                                <Path Fill="White" Data="M 9.1,7.4 C 9.4,7.4 9.6,7.5 9.7,7.8 L 10.5,9.6 C 10.6,9.9 10.5,10.2 10.3,10.4 L 9.8,10.9 C 10.4,12.1 11.4,13.1 12.7,13.8 L 13.2,13.3 C 13.4,13.1 13.7,13 14,13.1 L 15.8,13.9 C 16.1,14 16.2,14.3 16.2,14.6 L 16.1,15.5 C 16,16 15.6,16.4 15.1,16.4 C 11.3,16.4 7.3,12.5 7.3,8.6 C 7.3,8.1 7.7,7.6 8.2,7.5 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
