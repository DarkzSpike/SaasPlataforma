<Window x:Class="Comercial.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SystemName}" Width="1480" Height="920" MinWidth="1200" MinHeight="760"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" FontFamily="{DynamicResource AppFont}" Background="{DynamicResource BgBrush}">
    <Window.Icon>
        <DrawingImage>
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#12A86B" Geometry="M2,3 L5,3 L8,14 L19,14 L22,6 L7,6 M9,18 A1.5,1.5 0 1 0 9,21 A1.5,1.5 0 1 0 9,18 M17,18 A1.5,1.5 0 1 0 17,21 A1.5,1.5 0 1 0 17,18">
                    <GeometryDrawing.Pen><Pen Brush="#12A86B" Thickness="2"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Icon>
    <ContentControl Content="{Binding Current}" Focusable="False"/>
</Window>
