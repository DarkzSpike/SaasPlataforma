<UserControl x:Class="Comercial.Desktop.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#26F5A524" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Banner}" Foreground="White" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="12" Padding="12,5" VerticalAlignment="Top"
                                                Background="{Binding Tone, Converter={StaticResource Tone}}">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Amount}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                                                <Run Text="Vencimento:"/> <Run Text="{Binding Due, Mode=OneWay}" Foreground="White"/>
                                                <Run Text="  •  Período:"/> <Run Text="{Binding Period, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PaidInfo}" Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,6,0,0"
                                                       Visibility="{Binding PaidInfo, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- PIX gerado: QR + copia e cola -->
                                    <Border Margin="0,16,0,0" Padding="16" CornerRadius="10" Background="{DynamicResource Surface2Brush}" Visibility="{Binding HasPix, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8" Margin="0,0,18,0" VerticalAlignment="Top"
                                                    Visibility="{Binding PixImage, Converter={StaticResource Vis}}">
                                                <Image Source="{Binding PixImage}" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR Code PIX"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="Pague com PIX" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="Abra o app do seu banco, escolha PIX e leia o QR Code ou use o PIX copia e cola." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                                <TextBox Text="{Binding PixCode, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="70" Style="{StaticResource DarkInput}" Height="Auto" Padding="10"
                                                         AutomationProperties.Name="Código PIX copia e cola"/>
                                                <DockPanel Margin="0,10,0,0">
                                                    <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE8C8;" Content="Copiar código PIX" Padding="14,0"
                                                            Command="{Binding DataContext.CopyPixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding PixExpires}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <WrapPanel Margin="0,16,0,0" Visibility="{Binding IsOpen, Converter={StaticResource Vis}}">
                                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE8C7;" Content="Pagar com PIX" Padding="16,0" Margin="0,0,10,0"
                                                Command="{Binding DataContext.PixCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8A1;" Content="Cartão ou boleto" Padding="16,0" Margin="0,0,10,0"
                                                ToolTip="Abre a página segura do Mercado Pago no navegador"
                                                Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE895;" Content="Já paguei (verificar)" Padding="16,0"
                                                Command="{Binding DataContext.RefreshPaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Nenhuma fatura ainda. Elas são geradas automaticamente alguns dias antes do vencimento." Style="{StaticResource Muted}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
        </Grid>
    </DockPanel>
</UserControl>
