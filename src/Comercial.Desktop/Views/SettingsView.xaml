<UserControl x:Class="Comercial.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Menu lateral: ordem e ícones visíveis (vale para este computador) -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Menu lateral" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"
                               Text="Use as setas para mudar a ordem e desmarque para esconder um ícone. Vale para este computador. Vendas sempre aparece."/>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72C;" Content="Voltar ao padrão" Margin="0,12,0,0" Command="{Binding ResetMenuCommand}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Menu}" AutomationProperties.Name="Ícones do menu">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,6">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE70E;" Height="30" Padding="6,0" ToolTip="Subir" AutomationProperties.Name="Subir"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE70D;" Height="30" Padding="6,0" ToolTip="Descer" AutomationProperties.Name="Descer"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Visible}" IsEnabled="{Binding CanHide}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      ToolTip="Mostrar no menu" AutomationProperties.Name="{Binding Title}"/>
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" Foreground="White" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- WhatsApp da loja (API oficial da Meta) -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="O WhatsApp da loja é configurado pelo dono." Style="{StaticResource Muted}"
                               Visibility="{Binding CanWhatsApp, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <DockPanel Visibility="{Binding CanWhatsApp, Converter={StaticResource Vis}}">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#25D366" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="WhatsApp da loja (API oficial da Meta)" Style="{StaticResource SectionTitle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WaStatus}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,6"/>
                            <TextBlock Text="{Binding OptionsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE71B;" Content="Conectar" Padding="16,0" Margin="0,0,8,8" Command="{Binding ConnectCommand}"/>
                                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE713;" Content="Opções e limites" Padding="16,0" Margin="0,0,8,8" Command="{Binding OptionsCommand}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE724;" Content="Enviar teste" Padding="16,0" Margin="0,0,8,8" Command="{Binding TestCommand}"
                                        Visibility="{Binding Connected, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE711;" Content="Desconectar" Padding="16,0" Margin="0,0,8,8" Foreground="{DynamicResource DangerBrush}"
                                        Command="{Binding DisconnectCommand}" Visibility="{Binding Connected, Converter={StaticResource Vis}}"/>
                            </WrapPanel>
                            <Expander Header="Como configurar na Meta (passo a passo)" Foreground="White" Margin="0,8,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="22"
                                               Text="1. Em business.facebook.com crie (ou use) a conta empresarial da loja e, em developers.facebook.com, um app do tipo Empresa com o produto WhatsApp.&#x0a;2. Adicione o número da loja (ele não pode estar em uso no aplicativo WhatsApp comum) e verifique a empresa.&#x0a;3. Crie um usuário do sistema com token permanente (permissões whatsapp_business_messaging e whatsapp_business_management).&#x0a;4. Em Modelos de mensagem, crie os dois modelos abaixo e espere a aprovação da Meta.&#x0a;5. Em Webhooks do app, cole a URL e o token de verificação abaixo e assine o campo messages (para o SAIR funcionar o endereço precisa ser público, com HTTPS).&#x0a;6. Clique em Conectar e cole a identificação do número e o token."/>
                                    <TextBlock Text="URL de retorno (webhook)" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,12,0,4"/>
                                    <TextBox Style="{StaticResource DarkInput}" Text="{Binding WebhookUrl, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="URL de retorno"/>
                                    <TextBlock Text="Token de verificação" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,8,0,4"/>
                                    <TextBox Style="{StaticResource DarkInput}" Text="{Binding VerifyToken, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Token de verificação"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C8;" Content="Copiar URL e token" Padding="14,0" Margin="0,0,8,0" Command="{Binding CopyWebhookCommand}"/>
                                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C8;" Content="Copiar textos dos modelos" Padding="14,0" Command="{Binding CopyTemplatesCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Modelo de cobrança (Utilidade)" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding ChargeTemplateText}" Foreground="White" TextWrapping="Wrap"/>
                                    <TextBlock Text="Modelo de promoção (Marketing)" Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,10,0,4"/>
                                    <TextBlock Text="{Binding PromoTemplateText}" Foreground="White" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Últimos envios" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                        </StackPanel>
                        <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Messages}" RowHeight="38" AutomationProperties.Name="Últimos envios do WhatsApp">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quando" Binding="{Binding When}" Width="110"/>
                                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="110"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="170"/>
                                <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Mensagem / erro" Binding="{Binding Detail}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
