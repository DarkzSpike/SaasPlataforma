<UserControl x:Class="Comercial.Desktop.Views.StorePaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="PIX com QR Code no caixa" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Na venda em PIX o QR Code aparece na tela com o valor certo; quando o cliente paga, a venda confirma sozinha — sem conferir extrato. Exige internet; sem internet, o PIX continua podendo ser lançado manualmente."/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE71B;" Content="Conectar conta Mercado Pago" Padding="16,0" Margin="0,0,10,0" Command="{Binding ConnectCommand}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE7E8;" Content="Ativar / desativar PIX no caixa" Padding="16,0" Command="{Binding ToggleCommand}"
                                Visibility="{Binding Configured, Converter={StaticResource Vis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Como pegar o Access Token da loja" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="24"
                               Text="1. Entre no Mercado Pago da loja (pode ser conta de pessoa física) em mercadopago.com.br/developers.&#x0a;2. Suas integrações → Criar aplicação → Pagamentos online.&#x0a;3. Em Credenciais de produção, copie o Access Token (para testar sem cobrar, use as credenciais de teste).&#x0a;4. Clique em Conectar conta Mercado Pago e cole."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</UserControl>
