<UserControl x:Class="Comercial.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE74E;" Content="Salvar configuração" HorizontalAlignment="Right" Padding="20,0" Margin="0,12,0,0" Command="{Binding SaveCommand}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,12">
                    <StackPanel>
                        <TextBlock Text="Impressora de cupom e gaveta" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Impressora" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer}" AutomationProperties.Name="Impressora de cupom"/>
                        <TextBlock Text="Largura do papel" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding PaperOptions}" SelectedItem="{Binding Paper}" AutomationProperties.Name="Largura do papel"/>
                        <CheckBox IsChecked="{Binding EscPos}" Margin="0,14,0,0" Foreground="White" Content="Impressora térmica ESC/POS (Elgin, Epson, Bematech, Daruma...)"/>
                        <CheckBox IsChecked="{Binding AutoPrint}" Margin="0,8,0,0" Foreground="White" Content="Imprimir o cupom automaticamente ao finalizar a venda"/>
                        <CheckBox IsChecked="{Binding OpenDrawerOnCash}" Margin="0,8,0,0" Foreground="White" Content="Abrir a gaveta em vendas com dinheiro, sangria e suprimento"/>
                        <TextBlock Text="Rodapé do cupom" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE70F;" Text="{Binding Footer, UpdateSourceTrigger=PropertyChanged}" local:Ui.Placeholder="Obrigado pela preferência!"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE749;" Content="Imprimir teste" Padding="14,0" Margin="0,0,8,0" Command="{Binding TestPrintCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C7;" Content="Abrir gaveta" Padding="14,0" Command="{Binding TestDrawerCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <StackPanel Margin="8,0,0,0">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Balança" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Balança no caixa (serial/USB-serial): ao vender produto em KG o peso é lido sozinho. Etiqueta de balança (código que começa com 2): o PDV reconhece produto e preço/peso."/>
                            <TextBlock Text="Porta da balança do caixa" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Ports}" SelectedItem="{Binding ScalePort}" AutomationProperties.Name="Porta da balança"/>
                            <TextBlock Text="Velocidade (baud)" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                            <TextBox Style="{StaticResource DarkInput}" Text="{Binding ScaleBaud, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Etiqueta da balança" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,6"/>
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding BarcodeModes}" SelectedItem="{Binding BarcodeMode}"/>
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding CodeDigitOptions}" SelectedItem="{Binding CodeDigits}" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE9D9;" Content="Ler peso agora" HorizontalAlignment="Left" Padding="14,0" Margin="0,14,0,0" Command="{Binding TestScaleCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Impressora de etiquetas (ZPL)" Style="{StaticResource SectionTitle}"/>
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Printers}" SelectedItem="{Binding LabelPrinter}" Margin="0,12,0,0" AutomationProperties.Name="Impressora de etiquetas"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8EC;" Content="Imprimir etiqueta de teste" HorizontalAlignment="Left" Padding="14,0" Margin="0,14,0,0" Command="{Binding TestLabelCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </UniformGrid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
