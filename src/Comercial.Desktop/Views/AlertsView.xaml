<UserControl x:Class="Comercial.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>

        <!-- Pagar a fatura sem sair dos Avisos: PIX com QR Code, cartão/boleto e "Já paguei" -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding Paying, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Fechar" Height="36" VerticalAlignment="Top" Command="{Binding ClosePayCommand}"/>
                <Border DockPanel.Dock="Left" Background="White" CornerRadius="8" Padding="8" Margin="0,0,20,0" VerticalAlignment="Top"
                        Visibility="{Binding PayRow.PixImage, Converter={StaticResource Vis}}">
                    <Image Source="{Binding PayRow.PixImage}" Width="180" Height="180" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR Code PIX"/>
                </Border>
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">
                        <Run Text="Pagar fatura: "/><Run Text="{Binding PayRow.Amount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0">
                        <Run Text="Vencimento "/><Run Text="{Binding PayRow.Due, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding PayRow.Status, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Abra o app do seu banco, escolha PIX e leia o QR Code (ou use o copia e cola). Depois clique em &quot;Já paguei&quot;."
                               Foreground="{DynamicResource TextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding PayRow.HasPix, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding PayRow.PixExpires}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding PayRow.PaidInfo}" Foreground="{DynamicResource PrimaryLightBrush}" FontSize="15" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Pay.Info}" Foreground="{DynamicResource PrimaryLightBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding Pay.Error}" Foreground="{DynamicResource DangerBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,14,0,0" Visibility="{Binding PayRow.IsOpen, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE8C8;" Content="Copiar código PIX" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding Pay.CopyPixCommand}" CommandParameter="{Binding PayRow}" Visibility="{Binding PayRow.HasPix, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C7;" Content="Cartão ou boleto" Padding="14,0" Margin="0,0,10,0"
                                Command="{Binding Pay.CheckoutCommand}" CommandParameter="{Binding PayRow}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE73E;" Content="Já paguei" Padding="14,0"
                                Command="{Binding Pay.RefreshPaymentCommand}" CommandParameter="{Binding PayRow}"/>
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE8C7;" Content="Pagar agora" Height="36" Padding="14,0" Margin="0,0,10,0"
                                                Visibility="{Binding CanPay, Converter={StaticResource Vis}}"
                                                Command="{Binding DataContext.PayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource DarkButton}" Content="Marcar como lido" Height="36"
                                                Visibility="{Binding Unread, Converter={StaticResource Vis}}"
                                                Command="{Binding DataContext.ReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
                                        <Ellipse Fill="{DynamicResource WarnBrush}" Opacity="0.18"/>
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource WarnBrush}"/>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers><DataTrigger Binding="{Binding Unread}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,4"/>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="Nenhum aviso." Style="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
        </Grid>
    </DockPanel>
</UserControl>
