<UserControl x:Class="Comercial.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <Grid Background="{DynamicResource LoginGradientBrush}" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Fundo da empresa (white label): imagem com uma camada da cor da marca por cima para o texto continuar legível -->
        <Image Grid.ColumnSpan="2" Source="{DynamicResource LoginBackground}" Stretch="UniformToFill" Visibility="{DynamicResource HasLoginBackground}"/>
        <Rectangle Grid.ColumnSpan="2" Fill="{DynamicResource LoginGradientBrush}" Opacity="0.55" Visibility="{DynamicResource HasLoginBackground}"/>

        <!-- Fundo claro com borda curva + ondas decorativas -->
        <Path Grid.Column="1" Margin="-170,0,0,0" Stretch="Fill" Fill="{DynamicResource LightBgBrush}"
              Data="M 0.38,0 C 0.05,0.28 0.42,0.55 0.12,0.78 C 0.02,0.86 0.04,0.95 0,1 L 1,1 L 1,0 Z"/>
        <Path Grid.Column="1" Margin="0,520,0,0" Stretch="Fill" Fill="{DynamicResource PrimaryBrush}" Opacity="0.14"
              Data="M 0,1 C 0.3,0.45 0.6,0.9 1,0.2 L 1,1 Z"/>
        <Path Grid.Column="1" Margin="-170,600,0,0" Stretch="Fill" Fill="{DynamicResource PrimaryLightBrush}" Opacity="0.18"
              Data="M 0,0.7 C 0.25,0.2 0.45,1 0.75,0.55 C 0.85,0.4 0.95,0.45 1,0.3 L 1,1 L 0,1 Z"/>

        <!-- Coluna da marca -->
        <Grid Margin="90,70,40,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BF;" FontSize="84" Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,0,22,0"
                           Visibility="{DynamicResource NoLogoOnDark}"/>
                <Image Source="{DynamicResource LogoOnDark}" MaxHeight="110" MaxWidth="260" Stretch="Uniform" Margin="0,0,22,0" VerticalAlignment="Center"
                       Visibility="{DynamicResource HasLogoOnDark}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="56" FontWeight="Bold">
                        <Run Text="{DynamicResource BrandFirst}" Foreground="White"/><Run Text="{DynamicResource BrandLast}" Foreground="{DynamicResource PrimaryLightBrush}"/>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource TaglineSpaced}" Foreground="#CCFFFFFF" FontSize="12.5" Margin="4,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,56,0,0">
                <TextBlock Text="{DynamicResource WelcomeMessage}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource LoginSubtitle}" Foreground="#DDFFFFFF" FontSize="19" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Ilustração da empresa (white label) ou o desenho padrão do PDV -->
            <Image Grid.Row="2" Source="{DynamicResource LoginImage}" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="560" Margin="0,20,0,20"
                   Stretch="Uniform" Visibility="{DynamicResource HasLoginImage}" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Viewbox Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="520" Margin="-10,20,0,20" Visibility="{DynamicResource NoLoginImage}">
                <Canvas Width="520" Height="330">
                    <Rectangle Canvas.Left="0" Canvas.Top="290" Width="520" Height="26" RadiusX="6" RadiusY="6" Fill="#33000000"/>
                    <!-- impressora -->
                    <Rectangle Canvas.Left="10" Canvas.Top="190" Width="130" Height="100" RadiusX="12" RadiusY="12" Fill="#1E2730"/>
                    <Path Canvas.Left="38" Canvas.Top="150" Fill="#F2F5F4" Data="M0,0 L74,0 L70,52 L4,52 Z"/>
                    <Rectangle Canvas.Left="48" Canvas.Top="162" Width="50" Height="3" Fill="#B9C2C0"/>
                    <Rectangle Canvas.Left="48" Canvas.Top="172" Width="40" Height="3" Fill="#B9C2C0"/>
                    <Rectangle Canvas.Left="28" Canvas.Top="200" Width="94" Height="8" RadiusX="3" RadiusY="3" Fill="#0E141A"/>
                    <!-- monitor -->
                    <Path Canvas.Left="150" Canvas.Top="242" Fill="#232D37" Data="M30,0 L110,0 L130,48 L10,48 Z"/>
                    <Rectangle Canvas.Left="100" Canvas.Top="10" Width="300" Height="235" RadiusX="16" RadiusY="16" Fill="#1A232C">
                        <Rectangle.RenderTransform><SkewTransform AngleY="-4"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Canvas.Left="114" Canvas.Top="24" Width="272" Height="200" RadiusX="8" RadiusY="8" Fill="#0E1A1F">
                        <Rectangle.RenderTransform><SkewTransform AngleY="-4"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Canvas Canvas.Left="114" Canvas.Top="24">
                        <Canvas.RenderTransform><SkewTransform AngleY="-4"/></Canvas.RenderTransform>
                        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="252" Height="14" RadiusX="4" RadiusY="4" Fill="{DynamicResource PrimaryBrush}" Opacity="0.85"/>
                        <Rectangle Canvas.Left="10" Canvas.Top="32" Width="80" Height="156" RadiusX="6" RadiusY="6" Fill="{DynamicResource PrimaryLightBrush}" Opacity="0.85"/>
                        <TextBlock Canvas.Left="30" Canvas.Top="44" Style="{StaticResource Glyph}" Text="&#xE7BF;" FontSize="34" Foreground="#0E3A2A"/>
                        <Rectangle Canvas.Left="20" Canvas.Top="100" Width="60" Height="8" RadiusX="3" RadiusY="3" Fill="#0E7A50"/>
                        <Rectangle Canvas.Left="20" Canvas.Top="116" Width="48" Height="8" RadiusX="3" RadiusY="3" Fill="#0E7A50"/>
                        <Rectangle Canvas.Left="20" Canvas.Top="160" Width="60" Height="16" RadiusX="4" RadiusY="4" Fill="#0B8A55"/>
                        <Rectangle Canvas.Left="100" Canvas.Top="34" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="182" Canvas.Top="34" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="100" Canvas.Top="76" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="182" Canvas.Top="76" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="100" Canvas.Top="118" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="182" Canvas.Top="118" Width="74" Height="34" RadiusX="5" RadiusY="5" Fill="#2B3A44"/>
                        <Rectangle Canvas.Left="200" Canvas.Top="162" Width="56" Height="16" RadiusX="4" RadiusY="4" Fill="{DynamicResource PrimaryBrush}"/>
                    </Canvas>
                    <!-- leitor de código de barras -->
                    <Path Canvas.Left="405" Canvas.Top="120" Fill="#1E2730" Data="M10,0 L70,0 Q86,0 84,16 L78,40 Q75,52 62,52 L38,52 L30,150 L8,150 L14,52 Q0,48 2,30 Z"/>
                    <Rectangle Canvas.Left="420" Canvas.Top="126" Width="54" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource PrimaryLightBrush}"/>
                    <Rectangle Canvas.Left="398" Canvas.Top="268" Width="70" Height="22" RadiusX="8" RadiusY="8" Fill="#1E2730"/>
                </Canvas>
            </Viewbox>

            <UniformGrid Grid.Row="3" Rows="1" HorizontalAlignment="Left" MaxWidth="600">
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="30" Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Feature1}" Foreground="#E6FFFFFF" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="130"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="30" Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Feature2}" Foreground="#E6FFFFFF" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="130"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE9D2;" FontSize="30" Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{DynamicResource Feature3}" Foreground="#E6FFFFFF" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="130"/>
                </StackPanel>
            </UniformGrid>
        </Grid>

        <!-- Cartão de login -->
        <Border Grid.Column="1" Width="540" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40,40,40"
                Background="{DynamicResource CardBrush}" CornerRadius="20" Padding="48,44" BorderBrush="{DynamicResource LightBorderBrush}" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.18" Color="#0B2A1E"/></Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Criar conta grátis" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,18"
                           Visibility="{Binding SignupMode, Converter={StaticResource Vis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,34" Visibility="{Binding NotSignup, Converter={StaticResource Vis}}">
                    <Grid Width="92" Height="92">
                        <Ellipse Fill="{DynamicResource PrimarySoftBrush}"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="38" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}"
                                   Visibility="{DynamicResource NoBrandIcon}"/>
                        <Image Source="{DynamicResource BrandIcon}" Width="60" Height="60" Stretch="Uniform" Visibility="{DynamicResource HasBrandIcon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="26,0,0,0">
                        <TextBlock Text="{DynamicResource SystemName}" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource LightTextBrush}"/>
                        <TextBlock Text="Acesse sua conta" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding NotSignup, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE825;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Código da empresa" FontSize="17" Foreground="{DynamicResource LightTextBrush}"/>
                </StackPanel>
                <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE825;" Text="{Binding TenantCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Código da empresa"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,24,0,10">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE715;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="E-mail" FontSize="17" Foreground="{DynamicResource LightTextBrush}"/>
                </StackPanel>
                <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE715;" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail"/>

                <StackPanel Visibility="{Binding LoginMode, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal" Margin="0,24,0,10">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="20" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="Senha" FontSize="17" Foreground="{DynamicResource LightTextBrush}"/>
                </StackPanel>
                <Grid>
                    <PasswordBox x:Name="Pwd" Style="{StaticResource LightPassword}" AutomationProperties.Name="Senha" PasswordChanged="Pwd_PasswordChanged"/>
                    <TextBox x:Name="PwdVisible" Style="{StaticResource LightInput}" Visibility="Collapsed" TextChanged="PwdVisible_TextChanged" AutomationProperties.Name="Senha visível"/>
                    <ToggleButton x:Name="Reveal" HorizontalAlignment="Right" Width="44" Height="44" Margin="0,0,6,0" Cursor="Hand" Focusable="False"
                                  Checked="Reveal_Changed" Unchecked="Reveal_Changed" ToolTip="Mostrar/ocultar senha" AutomationProperties.Name="Mostrar senha">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <TextBlock x:Name="Eye" Style="{StaticResource Glyph}" Text="&#xE7B3;" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource LightMutedBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Eye" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <StackPanel Visibility="{Binding NeedTotp, Converter={StaticResource Vis}}" Margin="0,20,0,0">
                    <TextBlock Text="Código do autenticador (6 dígitos)" FontSize="17" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,10"/>
                    <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE8D7;" Text="{Binding TotpCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Código do autenticador"/>
                </StackPanel>
                <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE72A;" Content="Entrar" Height="58" FontSize="20" Margin="0,36,0,0"
                        Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=Pwd}" IsDefault="True"/>
                <Button Content="Esqueci minha senha" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand" Command="{Binding ForgotCommand}"
                        Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" BorderThickness="0" FontSize="15" AutomationProperties.Name="Esqueci minha senha"/>
                <Button Content="Ainda não tem conta? Criar conta grátis" HorizontalAlignment="Center" Margin="0,6,0,0" Cursor="Hand" Command="{Binding SignupCommand}"
                        Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" BorderThickness="0" FontSize="15" FontWeight="SemiBold"/>
                <Button Content="{Binding ServerText}" HorizontalAlignment="Center" Margin="0,10,0,0" Cursor="Hand" Command="{Binding ServerCommand}"
                        Foreground="{DynamicResource LightMutedBrush}" Background="Transparent" BorderThickness="0" FontSize="12.5"
                        Visibility="{Binding NotServerMode, Converter={StaticResource Vis}}"
                        ToolTip="Trocar o endereço do servidor" AutomationProperties.Name="Endereço do servidor"/>
                <!-- Trocar o servidor (rede local, demonstração pela internet ou VPS) -->
                <StackPanel Visibility="{Binding ServerMode, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                    <TextBlock Text="Endereço do servidor" FontSize="15" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE774;" Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço do servidor"/>
                    <TextBlock Text="Rede local: 192.168.0.10:5080 • Internet: https://endereco" FontSize="12" Foreground="{DynamicResource LightMutedBrush}" Margin="2,4,0,0"/>
                    <TextBlock Text="{Binding ServerError}" Foreground="{DynamicResource DangerBrush}" FontSize="13" TextWrapping="Wrap" Margin="2,6,0,0"
                               Visibility="{Binding ServerError, Converter={StaticResource Vis}}"/>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Style="{StaticResource DarkButton}" Content="Cancelar" Margin="0,0,6,0" Command="{Binding CancelServerCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Testar e salvar" Margin="6,0,0,0" Command="{Binding SaveServerCommand}"/>
                    </UniformGrid>
                </StackPanel>
                </StackPanel>

                <!-- Cadastro com teste grátis (código de confirmação por e-mail) -->
                <StackPanel Visibility="{Binding SignupMode, Converter={StaticResource Vis}}" Margin="0,12,0,0">
                    <StackPanel Visibility="{Binding NotSignupSent, Converter={StaticResource Vis}}">
                        <TextBlock Text="Nome da loja" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE80F;" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da loja"/>
                        <TextBlock Text="Seu nome" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,14,0,8"/>
                        <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE77B;" Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Seu nome"/>
                        <TextBlock Text="CPF ou CNPJ (opcional)" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,14,0,8"/>
                        <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE8D7;" Text="{Binding Document, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CPF ou CNPJ"/>
                        <TextBlock Text="Crie uma senha (10+ caracteres, letras e números)" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,14,0,8"/>
                        <PasswordBox x:Name="SignupPwd" Style="{StaticResource LightPassword}" AutomationProperties.Name="Senha da nova conta"/>
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE715;" Content="Enviar código de confirmação" Height="52" FontSize="17" Margin="0,18,0,0"
                                Command="{Binding StartSignupCommand}" CommandParameter="{Binding ElementName=SignupPwd}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding SignupSent, Converter={StaticResource Vis}}">
                        <TextBlock Text="Código recebido no e-mail (6 dígitos)" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE8D7;" Text="{Binding SignupCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="Código de confirmação"/>
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Confirmar e criar minha loja" Height="52" FontSize="17" Margin="0,18,0,0"
                                Command="{Binding VerifySignupCommand}" CommandParameter="{Binding ElementName=SignupPwd}"/>
                    </StackPanel>
                    <Button Content="Voltar para o login" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand" Command="{Binding CancelSignupCommand}"
                            Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" BorderThickness="0" FontSize="15"/>
                </StackPanel>

                <!-- Redefinição de senha por código enviado ao e-mail -->
                <StackPanel Visibility="{Binding ResetMode, Converter={StaticResource Vis}}" Margin="0,24,0,0">
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE715;" Content="Enviar código por e-mail" Height="52" FontSize="17" Command="{Binding SendCodeCommand}"/>
                    <StackPanel Visibility="{Binding CodeSent, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                        <TextBlock Text="Código recebido (ex.: ABCD-2345)" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource LightInput}" local:Ui.Icon="&#xE8D7;" Text="{Binding ResetCode, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" AutomationProperties.Name="Código recebido"/>
                        <TextBlock Text="Nova senha (10+ caracteres, letras e números)" FontSize="16" Foreground="{DynamicResource LightTextBrush}" Margin="0,16,0,8"/>
                        <PasswordBox x:Name="NewPwd" Style="{StaticResource LightPassword}" AutomationProperties.Name="Nova senha"/>
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Trocar senha" Height="52" FontSize="17" Margin="0,18,0,0"
                                Command="{Binding ResetCommand}" CommandParameter="{Binding ElementName=NewPwd}"/>
                    </StackPanel>
                    <Button Content="Voltar para o login" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand" Command="{Binding CancelResetCommand}"
                            Foreground="{DynamicResource PrimaryBrush}" Background="Transparent" BorderThickness="0" FontSize="15"/>
                </StackPanel>

                <Grid Margin="0,26,0,0" Visibility="{Binding Status, Converter={StaticResource Vis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" Fill="{DynamicResource LightBorderBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="18,0" FontSize="15" Foreground="{DynamicResource LightMutedBrush}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="{DynamicResource LightBorderBrush}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

