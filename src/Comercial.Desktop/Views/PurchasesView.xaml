<UserControl x:Class="Comercial.Desktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE710;" Content="Novo fornecedor" Margin="0,0,10,0" Command="{Binding NewSupplierCommand}"/>
                <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Novo pedido" Command="{Binding NewOrderCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="Pedidos" Command="{Binding ShowOrdersCommand}" Height="38" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding ShowOrders}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Fornecedores" Command="{Binding ShowSuppliersCommand}" Height="38">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                            <Style.Triggers><DataTrigger Binding="{Binding ShowSuppliers}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Fornecedores -->
        <Border Style="{StaticResource Card}" ClipToBounds="True" Visibility="{Binding ShowSuppliers, Converter={StaticResource Vis}}">
            <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Suppliers}" AutomationProperties.Name="Fornecedores">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="CNPJ/CPF" Binding="{Binding Document}" Width="170"/>
                    <DataGridTextColumn Header="Contato" Binding="{Binding Contact}" Width="170"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="150"/>
                    <DataGridTextColumn Header="Prazo (dias)" Binding="{Binding LeadTimeDays}" Width="110"/>
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DarkButton}" Content="Editar" Height="34" Padding="12,0"
                                        Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pedidos -->
        <Grid Visibility="{Binding ShowOrders, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,0,16,0">
                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Pedidos de compra">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº" Binding="{Binding Number}" Width="60"/>
                        <DataGridTextColumn Header="Fornecedor" Binding="{Binding Supplier}" Width="*"/>
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="150"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detalhe do pedido -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Visibility="{Binding Viewing, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding DetailInfo}" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                    <TextBlock DockPanel.Dock="Top" Text="Para receber: confira a quantidade e o custo de cada item na tabela e clique em Receber."
                               Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding CanReceive, Converter={StaticResource Vis}}"/>
                    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Aprovar" Margin="0,0,6,0" Command="{Binding ApproveCommand}"/>
                        <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE7B8;" Content="Receber" Margin="3,0" Command="{Binding ReceiveCommand}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE711;" Content="Cancelar" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding CancelOrderCommand}"/>
                    </UniformGrid>
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Lines}" RowHeight="50" AutomationProperties.Name="Itens do pedido">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Product}" Width="*"/>
                            <DataGridTextColumn Header="Pedido" Binding="{Binding OrderedText}" Width="80"/>
                            <DataGridTextColumn Header="Recebido" Binding="{Binding ReceivedText}" Width="90"/>
                            <DataGridTemplateColumn Header="Receber agora" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Style="{StaticResource DarkInput}" Height="36" Text="{Binding ReceiveQty, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantidade a receber"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Custo (R$)" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Style="{StaticResource DarkInput}" Height="36" Text="{Binding ReceiveCost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custo unitário"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Editor de novo pedido -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Visibility="{Binding Editing, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Novo pedido de compra" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Top" Text="Já trouxemos os produtos que estão no estoque mínimo. Ajuste quantidades e custos." Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fornecedor" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding EditorSupplier}" AutomationProperties.Name="Fornecedor">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Products}" SelectedItem="{Binding ProductToAdd}" AutomationProperties.Name="Produto para adicionar">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE710;" Content="Adicionar" Margin="10,0,0,0" Command="{Binding AddLineCommand}"/>
                    </Grid>
                    <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,14,0,0">
                        <Button Style="{StaticResource DarkButton}" Content="Voltar" Margin="0,0,6,0" Command="{Binding CancelEditorCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Salvar pedido (rascunho)" Margin="6,0,0,0" Command="{Binding SaveOrderCommand}"/>
                    </UniformGrid>
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding EditorLines}" RowHeight="50" AutomationProperties.Name="Itens do novo pedido">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="Quantidade" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Style="{StaticResource DarkInput}" Height="36" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantidade"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Custo (R$)" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Style="{StaticResource DarkInput}" Height="36" Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custo"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE74D;" ToolTip="Remover" AutomationProperties.Name="Remover item"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
