<UserControl x:Class="Comercial.Desktop.Views.ProfitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding DiscountNote}" Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0" Visibility="{Binding DiscountNote, Converter={StaticResource Vis}}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" ClipToBounds="True">
                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Products}" AutomationProperties.Name="Lucro por produto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="70"/>
                        <DataGridTextColumn Header="Vendas" Binding="{Binding Revenue}" Width="110"/>
                        <DataGridTextColumn Header="Custo" Binding="{Binding Cost}" Width="110"/>
                        <DataGridTemplateColumn Header="Lucro" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Profit}" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Margem" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="120" Height="8" CornerRadius="4" Background="{DynamicResource Surface3Brush}" VerticalAlignment="Center">
                                            <Border Width="{Binding MarginWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Margin}" Foreground="{DynamicResource TextBrush}" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Vendas" Style="{StaticResource Muted}" Margin="0,0,14,0"/>
                            <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Lucro" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <TextBlock Text="Por dia" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <TextBlock Text="Escolha um período com mais de um dia para ver o gráfico." Style="{StaticResource Muted}" Visibility="{Binding HasBars, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource BarTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
