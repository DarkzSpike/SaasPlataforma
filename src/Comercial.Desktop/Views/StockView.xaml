<UserControl x:Class="Comercial.Desktop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Filtrar por nome ou SKU" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar estoque"/>
            <CheckBox Grid.Column="1" Content="Só estoque baixo" IsChecked="{Binding OnlyLow}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="18,0" FontSize="14"/>
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <Border Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Items}" AutomationProperties.Name="Saldos de estoque">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                    <DataGridTextColumn Header="Em estoque" Binding="{Binding Quantity}" Width="130"/>
                    <DataGridTextColumn Header="Mínimo" Binding="{Binding Min}" Width="110"/>
                    <DataGridTemplateColumn Header="Situação" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2612A86B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Low}" Value="True"><Setter Property="Background" Value="#40F5A524"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12.5" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Low}" Value="True"><Setter Property="Text" Value="Repor"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
