<UserControl x:Class="Comercial.Desktop.Views.FiscalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <UserControl.Resources>
        <!-- Abas das seções (Visão geral, Documentos, ...) -->
        <Style x:Key="SectionTab" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="B" CornerRadius="8" Padding="12,8" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Selo colorido do estado de cada verificação do fechamento -->
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="#33808A99"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="concluido"><Setter Property="Background" Value="#3312A86B"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="divergencia"><Setter Property="Background" Value="#55E5484D"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="pendente"><Setter Property="Background" Value="#55F5A524"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="em_analise"><Setter Property="Background" Value="#551E8CFF"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>

        <!-- Abas -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" ItemContainerStyle="{StaticResource SectionTab}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Seções">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <!-- Período e loja -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Período:" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Months}" SelectedItem="{Binding Month}" Width="160" Margin="0,0,8,0" AutomationProperties.Name="Mês"/>
            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" Width="110" Margin="0,0,18,0" AutomationProperties.Name="Ano"/>
            <TextBlock Text="Loja:" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Stores}" SelectedItem="{Binding Store}" Width="220" AutomationProperties.Name="Loja"/>
        </StackPanel>

        <!-- Mensagens -->
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="120" Height="6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Busy}" Foreground="White"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#1F12A86B" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <Grid>
            <!-- ========== VISÃO GERAL ========== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsGeral, Converter={StaticResource Vis}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="Pendências antes do fechamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Pendencies}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding OverviewStatus}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
                            <StackPanel>
                                <TextBlock Text="Vendas por meio de pagamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding PaymentLines}">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Valor vendido não é o valor recebido: veja a conciliação em Relatórios." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== DOCUMENTOS ========== -->
            <DockPanel Visibility="{Binding IsDocumentos, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Buscar XMLs no provedor" Padding="14,0" Command="{Binding FetchXmlCommand}"
                            ToolTip="Baixa do provedor fiscal os XMLs originais que ainda faltam no arquivo"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="230" Margin="0,0,8,0" AutomationProperties.Name="Situação"/>
                        <TextBox Style="{StaticResource DarkInput}" Text="{Binding NumberFilter}" Width="140" Margin="0,0,8,0" local:Ui.Icon="&#xE8EF;" local:Ui.Placeholder="Número" ToolTip="Número" AutomationProperties.Name="Número"/>
                        <TextBox Style="{StaticResource DarkInput}" Text="{Binding SeriesFilter}" Width="110" Margin="0,0,8,0" local:Ui.Icon="&#xE8EF;" local:Ui.Placeholder="Série" ToolTip="Série" AutomationProperties.Name="Série"/>
                        <TextBox Style="{StaticResource DarkInput}" Text="{Binding KeyFilter}" Width="260" Margin="0,0,8,0" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Chave de acesso" ToolTip="Chave de acesso (parte)" AutomationProperties.Name="Chave de acesso"/>
                        <Button Style="{StaticResource AccentButton}" Content="Filtrar" Padding="16,0" Command="{Binding SearchCommand}" IsDefault="True"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="‹ Anterior" Command="{Binding PrevPageCommand}" Padding="10,0"/>
                        <TextBlock Text="{Binding PageInfo}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0"/>
                        <Button Style="{StaticResource GhostButton}" Content="Próxima ›" Command="{Binding NextPageCommand}" Padding="10,0"/>
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Right" Margin="0,0,76,0">
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE946;" Content="Detalhes" Padding="12,0" Margin="0,0,6,0" Command="{Binding DetailCommand}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Baixar XML" Padding="12,0" Margin="0,0,6,0" Command="{Binding DownloadXmlCommand}"/>
                        <Button Style="{StaticResource DarkButton}" Content="XML do cancelamento" Padding="12,0" Margin="0,0,6,0" Command="{Binding DownloadCancelXmlCommand}"/>
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8A5;" Content="DANFE" Padding="12,0" Margin="0,0,6,0" Command="{Binding OpenDanfeCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE724;" Content="Transmitir" Padding="12,0" Margin="0,0,6,0" Command="{Binding TransmitCommand}"/>
                        <Button Style="{StaticResource DarkButton}" Content="Cancelar NFC-e" Padding="12,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding CancelCommand}"/>
                    </WrapPanel>
                </DockPanel>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Docs}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Documentos fiscais" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Emissão" Binding="{Binding When}" Width="150"/>
                            <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="100"/>
                            <DataGridTextColumn Header="Número" Binding="{Binding Number}" Width="85"/>
                            <DataGridTextColumn Header="Série" Binding="{Binding Series}" Width="65"/>
                            <DataGridTextColumn Header="Destinatário" Binding="{Binding Recipient}" Width="210"/>
                            <DataGridTextColumn Header="Valor" Binding="{Binding Total}" Width="95"/>
                            <DataGridTemplateColumn Header="Situação" Width="130" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="autorizada"><Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="rejeitada"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="denegada"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="pendente"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="contingencia"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="cancelada"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="XML" Binding="{Binding Xml}" Width="95"/>
                            <DataGridTextColumn Header="Chave de acesso" Binding="{Binding Key}" Width="250"/>
                            <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="130"/>
                            <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ========== EXPORTAÇÃO ========== -->
            <DockPanel Visibility="{Binding IsExportacao, Converter={StaticResource Vis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Incluir relatórios (CSV)" IsChecked="{Binding IncludeReports}" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE896;" Content="Gerar pacote do mês" Padding="16,0" Command="{Binding CreateExportCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Pacote para a contabilidade (ZIP)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ExportSummary}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"
                                       Text="Pastas: CNPJ › ano › mês › loja › NFCe › autorizadas / eventos / denegadas, inutilizações, Relatorios, resumo_exportacao.txt e manifesto_sha256.txt. XMLs são os originais, sem alteração."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,76,0">
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Baixar pacote" Padding="14,0" Margin="0,0,8,0" Command="{Binding DownloadExportCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE715;" Content="Enviar para o contador" Padding="14,0" Command="{Binding SendExportCommand}"/>
                </WrapPanel>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Exports}" SelectedItem="{Binding SelectedExport}" AutomationProperties.Name="Pacotes gerados">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Gerado em" Binding="{Binding When}" Width="140"/>
                            <DataGridTextColumn Header="Período" Binding="{Binding Period}" Width="90"/>
                            <DataGridTextColumn Header="NFC-e" Binding="{Binding Docs}" Width="70"/>
                            <DataGridTextColumn Header="Eventos" Binding="{Binding Events}" Width="75"/>
                            <DataGridTextColumn Header="Inutilizações" Binding="{Binding Voids}" Width="105"/>
                            <DataGridTextColumn Header="Pendências" Binding="{Binding Missing}" Width="95"/>
                            <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="85"/>
                            <DataGridTextColumn Header="Gerado por" Binding="{Binding By}" Width="140"/>
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding File}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ========== RELATÓRIOS ========== -->
            <DockPanel Visibility="{Binding IsRelatorios, Converter={StaticResource Vis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE896;" Content="Exportar CSV (Excel)" Padding="14,0" Command="{Binding ReportCsvCommand}"/>
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding ReportOptions}" SelectedItem="{Binding Report}" Width="380" HorizontalAlignment="Left" AutomationProperties.Name="Relatório"/>
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ReportTotals}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="White" FontWeight="SemiBold" Margin="0,0,24,6"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReportNotes}" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding ReportView}" AutoGenerateColumns="True" IsReadOnly="True" AutomationProperties.Name="Relatório"
                              HorizontalScrollBarVisibility="Auto" ColumnWidth="Auto" MinColumnWidth="90"/>
                </Border>
            </DockPanel>

            <!-- ========== FECHAMENTO ========== -->
            <DockPanel Visibility="{Binding IsFechamento, Converter={StaticResource Vis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72C;" Content="Verificar de novo" Padding="14,0" Margin="0,0,8,0" Command="{Binding RefreshCommand}"/>
                            <Button Style="{StaticResource DarkButton}" Content="Salvar resumo" Padding="14,0" Margin="0,0,8,0" Command="{Binding SaveSummaryCommand}"/>
                            <Button Style="{StaticResource DarkButton}" Content="Reabrir mês" Padding="14,0" Margin="0,0,8,0" Command="{Binding ReopenMonthCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Concluir fechamento" Padding="16,0" Command="{Binding CloseMonthCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Fechamento fiscal do mês" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding ClosingStatus}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Observações do fechamento (obrigatório quando há verificações não concluídas)" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ClosingNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="2000"
                                 Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" Padding="8" AutomationProperties.Name="Observações"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource StateBadge}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StateLabel}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="14.5"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding Items}" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasItems, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ========== CONTADOR ========== -->
            <DockPanel Visibility="{Binding IsContador, Converter={StaticResource Vis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE713;" Content="Configurar escritório" Padding="14,0" Margin="0,0,8,0" Command="{Binding ConfigureAccountantCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE715;" Content="Enviar pacote do mês" Padding="16,0" Command="{Binding SendMonthCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Escritório de contabilidade" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding AccountantSummary}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72C;" Content="Reenviar este pacote" Padding="14,0" Margin="0,0,76,0" Command="{Binding ResendCommand}"/>
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"
                               Text="&quot;Aceito pelo servidor de e-mail&quot; significa que o envio saiu do sistema; a leitura pelo contador não pode ser confirmada por e-mail."/>
                </DockPanel>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Deliveries}" SelectedItem="{Binding SelectedDelivery}" AutomationProperties.Name="Histórico de envios">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="140"/>
                            <DataGridTextColumn Header="Período" Binding="{Binding Period}" Width="85"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Trigger}" Width="115"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding StatusLabel}" Width="250"/>
                            <DataGridTextColumn Header="Destinatários" Binding="{Binding Recipients}" Width="220"/>
                            <DataGridTextColumn Header="Por" Binding="{Binding By}" Width="120"/>
                            <DataGridTextColumn Header="Detalhe" Binding="{Binding Detail}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- ========== CONFIGURAÇÕES ========== -->
            <StackPanel Visibility="{Binding IsConfig, Converter={StaticResource Vis}}">
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource DarkButton}" Content="Inutilizar numeração" Padding="14,0" Margin="0,0,10,0" Command="{Binding VoidCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8D7;" Content="Certificado digital" Padding="14,0" Margin="0,0,10,0" Command="{Binding CertificateCommand}"/>
                            <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE713;" Content="Dados do emitente" Padding="14,0" Command="{Binding ConfigureCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Emitente da NFC-e (modelo 65)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Modelos fiscais" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap">
                            NFC-e (65): emitida direto na SEFAZ do estado com o certificado A1 da loja (sem custo por nota) ou pela Focus NFe; os XMLs originais são guardados automaticamente.<LineBreak/>
                            NF-e (55), CF-e-SAT e ECF: não são emitidos por este sistema hoje — aparecem como "não aplicável" no fechamento.<LineBreak/>
                            Emissão direta: o certificado e a senha ficam criptografados no servidor e nunca voltam para nenhuma tela. Teste sempre em homologação antes de passar para produção.
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
