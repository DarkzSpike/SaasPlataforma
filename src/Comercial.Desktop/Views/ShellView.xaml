<UserControl x:Class="Comercial.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <Grid Background="{DynamicResource BgBrush}">
        <DockPanel>
            <!-- Cabeçalho -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderGradientBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BF;" FontSize="50" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"
                                   Visibility="{DynamicResource NoLogoOnDark}"/>
                        <Image Source="{DynamicResource LogoOnDark}" MaxHeight="60" MaxWidth="180" Stretch="Uniform" Margin="0,0,18,0" VerticalAlignment="Center"
                               Visibility="{DynamicResource HasLogoOnDark}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="34" FontWeight="Bold">
                                <Run Text="{DynamicResource BrandFirst}" Foreground="White"/><Run Text="{DynamicResource BrandLast}" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource HeaderSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="17" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>



                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="1" Height="44" Fill="{DynamicResource DarkBorderBrush}" Margin="0,0,20,0"/>
                        <Border Width="46" Height="46" CornerRadius="10" Background="{DynamicResource Surface3Brush}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock Text="{Binding Pos.CashText}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Pos.CashSubText}" Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE7E8;" Content="Sair" Command="{Binding LogoutCommand}" ToolTip="{Binding UserLabel}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barra de status -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="{Binding PendingText}" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Foreground="{DynamicResource TextBrush}">
                            <Run Text="Licença: "/><Run Text="{Binding LicenseText, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseOk}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource DarkBorderBrush}" Margin="22,0"/>
                        <TextBlock Text="&#xE701;" Margin="0,0,10,0" FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Online}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding OnlineText}" Foreground="{DynamicResource TextBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource DarkBorderBrush}" Margin="22,0"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="18"/>
                        <TextBlock Text="{Binding SyncText}" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Aviso de nova versão (assinada pelo servidor; o SHA-256 do instalador é conferido antes de instalar) -->
            <Border DockPanel.Dock="Top" Background="#2A1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="24,8"
                    Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE896;" Content="Atualizar agora" Padding="14,0" Height="36" Command="{Binding UpdateCommand}"/>
                    <TextBlock Text="{Binding UpdateText}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
                </DockPanel>
            </Border>

            <!-- Navegação lateral: só aparecem as áreas que a empresa contratou e o usuário pode ver -->
            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="0,0,1,0" Width="108">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0" Margin="0,8,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navegação">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="{Binding Title}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="2,5" Margin="8,1" CornerRadius="12" Background="Transparent">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock x:Name="Ic" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                                    <TextBlock x:Name="Tx" Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                                    <Setter TargetName="Ic" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Tx" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Border>
            <ContentControl Content="{Binding Page}" Margin="24,22,24,20" Focusable="False"/>
        </DockPanel>

        <!-- Venda concluída: troco em destaque; só fecha com a confirmação do operador -->
        <Grid Background="#CC050A14" Visibility="{Binding SaleDone, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="540" VerticalAlignment="Center" Padding="36,32" DataContext="{Binding SaleDone}">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <Grid Width="84" Height="84" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource PrimaryBrush}" Opacity="0.25"/>
                        <Ellipse Margin="10" Fill="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Headline}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <StackPanel Visibility="{Binding HasChange, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                        <TextBlock Text="TROCO" Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ChangeText}" Foreground="{DynamicResource PrimaryLightBrush}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="18,14" Margin="0,20,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Total da venda" Foreground="{DynamicResource TextBrush}" FontSize="16"/></DockPanel>
                            <DockPanel Margin="0,0,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding PaidText}" Foreground="White" FontSize="17"/><TextBlock Text="Valor recebido" Foreground="{DynamicResource TextBrush}" FontSize="16"/></DockPanel>
                            <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Method}" Foreground="White" FontSize="17"/><TextBlock Text="Forma de pagamento" Foreground="{DynamicResource TextBrush}" FontSize="16"/></DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding PointsText}" Foreground="{DynamicResource WarnBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Visibility="{Binding PointsText, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="{Binding ConfirmText}" Height="58" FontSize="18" Margin="0,24,0,0"
                            Command="{Binding ConfirmCommand}" IsDefault="True"/>
                    <TextBlock Text="{Binding FiscalText}" Foreground="{DynamicResource TextBrush}" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,12,0,0" MaxWidth="440" Visibility="{Binding HasFiscalText, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE749;" Content="Imprimir NFC-e (DANFE)" Margin="0,10,0,0"
                            Command="{Binding PrintDanfeCommand}" Visibility="{Binding CanPrintDanfe, Converter={StaticResource Vis}}"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE749;" Content="Imprimir comprovante" Margin="0,10,0,0"
                            Command="{Binding PrintCommand}" Visibility="{Binding CanPrint, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="Pressione Enter para confirmar" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Formulário (produto / entrada de mercadoria) -->
        <Grid Background="#B3050A14" Visibility="{Binding Form, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" MaxWidth="760" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28" DataContext="{Binding Form}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,18"/>
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <StackPanel Width="210" Margin="0,0,24,0" Visibility="{Binding AllowImage, Converter={StaticResource Vis}}">
                            <Border Width="210" Height="210" CornerRadius="12" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding HasImage, Converter={StaticResource Vis}, ConverterParameter=not}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock Text="Sem foto" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE722;" Content="Escolher foto" Margin="0,12,0,0" Command="{Binding PickImageCommand}"/>
                            <TextBlock Text="JPG ou PNG, até 5 MB" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Fields}" Width="420">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                                        <TextBox Style="{StaticResource DarkInput}" Height="42" local:Ui.Icon="{Binding Icon}" local:Ui.Placeholder="{Binding Placeholder}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 Visibility="{Binding IsText, Converter={StaticResource Vis}}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource AccentBrush}" FontSize="13" Margin="2,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" Height="42" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"
                                                  AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsChoice, Converter={StaticResource Vis}}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="Salvando..." Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Busy, Converter={StaticResource Vis}}"/>
                    <UniformGrid Rows="1" Margin="0,18,0,0">
                        <Button Style="{StaticResource DarkButton}" Content="Voltar" Command="{Binding CancelCommand}" Margin="0,0,6,0" IsCancel="True"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PIX no caixa: QR Code até o Mercado Pago confirmar -->
        <Grid Background="#CC050A14" Visibility="{Binding PixPay, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="560" VerticalAlignment="Center" Padding="32" DataContext="{Binding PixPay}">
                <StackPanel>
                    <TextBlock Text="Pagamento com PIX" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AmountText}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Center" Margin="0,6,0,14"/>
                    <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
                        <Image Source="{Binding QrImage}" Width="260" Height="260" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR Code PIX"/>
                    </Border>
                    <TextBlock Text="Peça para o cliente ler o QR Code no app do banco." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarnBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <UniformGrid Rows="1" Margin="0,20,0,0">
                        <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C8;" Content="Copiar código" Margin="0,0,6,0" Command="{Binding CopyCommand}"/>
                        <Button Style="{StaticResource DarkButton}" Content="Cancelar PIX" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding CancelCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diálogo sobreposto -->
        <Grid Background="#B3050A14" Visibility="{Binding Prompt, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" Padding="28" DataContext="{Binding Prompt}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,18"/>
                    <StackPanel Visibility="{Binding HasValue, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding ValueLabel}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE8C7;" local:Ui.Placeholder="0,00" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasText, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                        <TextBlock Text="{Binding TextLabel}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE70F;" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasUser, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                        <TextBlock Text="{Binding UserLabel}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE77B;" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail de quem autoriza"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasPassword, Converter={StaticResource Vis}}" Margin="0,14,0,0">
                        <TextBlock Text="{Binding PasswordLabel}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                        <PasswordBox Style="{StaticResource DarkPassword}" PasswordChanged="PromptPassword_Changed" DataContextChanged="PromptPassword_ContextChanged" AutomationProperties.Name="Senha de quem autoriza"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource Vis}}"/>
                    <UniformGrid Rows="1" Margin="0,22,0,0">
                        <Button Style="{StaticResource DarkButton}" Content="Voltar" Command="{Binding CancelCommand}" Margin="0,0,6,0" IsCancel="True"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
