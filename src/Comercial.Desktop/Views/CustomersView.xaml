<UserControl x:Class="Comercial.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <!-- Cobranças do dia: o sistema lembra e o WhatsApp da loja abre com a mensagem pronta (grátis) -->
        <Border DockPanel.Dock="Top" Background="#1F25D366" BorderBrush="#25D366" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasDue, Converter={StaticResource Vis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE8BD;" Content="Cobrar agora" Command="{Binding DueCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding DueText}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Buscar por nome, CPF ou telefone" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar cliente">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{StaticResource DarkButton}" Content="Buscar" Margin="10,0,0,0" Command="{Binding SearchCommand}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE734;" Content="Programa de pontos" Margin="0,0,10,0" Command="{Binding ProgramCommand}"/>
                <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Novo cliente" Command="{Binding NewCommand}"/>
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,0,16,0">
                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Clientes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="CPF" Binding="{Binding Document}" Width="130"/>
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="Selecione um cliente." Style="{StaticResource Muted}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DetailTitle}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DetailInfo}" Style="{StaticResource Muted}" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PointsText}" Foreground="{DynamicResource WarnBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"
                                           Visibility="{Binding PointsText, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                            <!-- Melhor dia para cobrar: todo mês o WhatsApp da loja manda o saldo e as compras do cliente -->
                            <Button Grid.Column="1" Command="{Binding BillingDayCommand}" Cursor="Hand" Margin="12,0,12,0" VerticalAlignment="Top"
                                    Visibility="{Binding CanBilling, Converter={StaticResource Vis}}" ToolTip="Escolher o dia do mês da cobrança" AutomationProperties.Name="Dia de cobrança">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8" MinWidth="220">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE787;" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,8,0"/>
                                                    <TextBlock Text="Dia de cobrança" Foreground="White" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding BillingText}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.6"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Cobrar agora pelo WhatsApp da loja -->
                            <Button Grid.Column="2" Width="54" Height="54" Cursor="Hand" VerticalAlignment="Top" Command="{Binding ChargeWhatsAppCommand}"
                                    Visibility="{Binding CanBilling, Converter={StaticResource Vis}}" ToolTip="Cobrar pelo WhatsApp da loja (grátis, mensagem pronta)" AutomationProperties.Name="Cobrar pelo WhatsApp">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse Fill="#25D366"/>
                                            <Viewbox Width="30" Height="30">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M 3.6,20.4 L 4.8,16.3 A 8.6,8.6 0 1 1 7.9,19.3 Z"/>
                                                    <Path Fill="White" Data="M 9.1,7.4 C 9.4,7.4 9.6,7.5 9.7,7.8 L 10.5,9.6 C 10.6,9.9 10.5,10.2 10.3,10.4 L 9.8,10.9 C 10.4,12.1 11.4,13.1 12.7,13.8 L 13.2,13.3 C 13.4,13.1 13.7,13 14,13.1 L 15.8,13.9 C 16.1,14 16.2,14.3 16.2,14.6 L 16.1,15.5 C 16,16 15.6,16.4 15.1,16.4 C 11.3,16.4 7.3,12.5 7.3,8.6 C 7.3,8.1 7.7,7.6 8.2,7.5 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.08" ScaleY="1.08"/></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding CreditText, Converter={StaticResource Vis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource DarkButton}" Content="Limite" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding LimitCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Receber fiado" Height="34" Padding="12,0" Command="{Binding ReceiveCreditCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CreditText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,14,0,0">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE70F;" Content="Editar" Margin="0,0,6,0" Command="{Binding EditCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Exportar dados (LGPD)" Margin="3,0" Command="{Binding ExportCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72E;" Content="Anonimizar" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding AnonymizeCommand}"/>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Top" Text="Últimas compras" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Recent}" RowHeight="38" AutomationProperties.Name="Últimas compras">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Extrato de pontos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Statement}" RowHeight="38" AutomationProperties.Name="Extrato de pontos">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="115"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                                        <DataGridTextColumn Header="Pontos" Binding="{Binding Points}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
