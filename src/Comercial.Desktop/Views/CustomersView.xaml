<UserControl x:Class="Comercial.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE721;" local:Ui.Placeholder="Buscar por nome, CPF ou telefone" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar cliente">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1" Style="{StaticResource DarkButton}" Content="Buscar" Margin="10,0,0,0" Command="{Binding SearchCommand}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE734;" Content="Programa de pontos" Margin="0,0,10,0" Command="{Binding ProgramCommand}"/>
                <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Novo cliente" Command="{Binding NewCommand}"/>
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True" Margin="0,0,16,0">
                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Clientes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="CPF" Binding="{Binding Document}" Width="130"/>
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Phone}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="Selecione um cliente." Style="{StaticResource Muted}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailInfo}" Style="{StaticResource Muted}" Margin="0,4,0,6"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PointsText}" Foreground="{DynamicResource WarnBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"
                                   Visibility="{Binding PointsText, Converter={StaticResource Vis}}"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding CreditText, Converter={StaticResource Vis}}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource DarkButton}" Content="Limite" Height="34" Padding="12,0" Margin="0,0,8,0" Command="{Binding LimitCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Receber fiado" Height="34" Padding="12,0" Command="{Binding ReceiveCreditCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CreditText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,14,0,0">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE70F;" Content="Editar" Margin="0,0,6,0" Command="{Binding EditCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Exportar dados (LGPD)" Margin="3,0" Command="{Binding ExportCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72E;" Content="Anonimizar" Margin="6,0,0,0" Foreground="{DynamicResource DangerBrush}" Command="{Binding AnonymizeCommand}"/>
                        </UniformGrid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Margin="0,0,10,0">
                                <TextBlock DockPanel.Dock="Top" Text="Últimas compras" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Recent}" RowHeight="38" AutomationProperties.Name="Últimas compras">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Extrato de pontos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Statement}" RowHeight="38" AutomationProperties.Name="Extrato de pontos">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Data" Binding="{Binding When}" Width="115"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                                        <DataGridTextColumn Header="Pontos" Binding="{Binding Points}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
