<UserControl x:Class="Comercial.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ContentControl Style="{StaticResource PageHeader}"/>
            <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource KpiTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16" Visibility="{Binding HasBars, Converter={StaticResource Vis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Vendas" Style="{StaticResource Muted}" Margin="0,0,16,0"/>
                                <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Lucro bruto" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="Últimos 14 dias" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Bars}" ItemTemplate="{StaticResource BarTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,16">
                    <StackPanel>
                        <TextBlock Text="Últimas vendas de hoje" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                        <TextBlock Text="Nenhuma venda hoje ainda." Style="{StaticResource Muted}" Visibility="{Binding Recent.Count, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Foreground="{DynamicResource TextBrush}"><Run Text="{Binding When, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Payment, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Operator}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
