<UserControl x:Class="Comercial.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,16,0">
                <Button DockPanel.Dock="Top" Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Novo funcionário" HorizontalAlignment="Left" Padding="16,0" Margin="0,0,0,12" Command="{Binding NewCommand}"/>
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Funcionários">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Nome" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="White"/>
                                            <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Função" Binding="{Binding RoleName}" Width="170"/>
                            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="Selecione um funcionário." Style="{StaticResource Muted}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock DockPanel.Dock="Top" Text="Esta é a sua conta: suas permissões não podem ser alteradas por aqui." Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding CanEditSelected, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,14,0,10" IsEnabled="{Binding CanEditSelected}">
                            <TextBlock Text="Função" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding Role}" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Função">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE74E;" Content="Salvar permissões" Padding="14,0" Margin="0,0,8,8" Command="{Binding SaveCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72E;" Content="Nova senha" Padding="14,0" Margin="0,0,8,8" Command="{Binding ResetPasswordCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C7;" Content="Comissão" Padding="14,0" Margin="0,0,8,8" Command="{Binding CommissionCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE7E8;" Content="Desconectar" Padding="14,0" Margin="0,0,8,8" Command="{Binding LogoutUserCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8D7;" Content="Remover 2 etapas" Padding="14,0" Margin="0,0,8,8" Command="{Binding ResetTwoFactorCommand}" ToolTip="Use quando o funcionário perdeu o celular do autenticador"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8F8;" Content="Bloquear / desbloquear" Padding="14,0" Margin="0,0,8,8" Foreground="{DynamicResource DangerBrush}" Command="{Binding BlockCommand}"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="O que esta pessoa pode fazer" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEditSelected}">
                            <ItemsControl ItemsSource="{Binding PermissionsList}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Checked}" IsEnabled="{Binding Enabled}" Margin="0,3,12,3" ToolTip="{Binding Key}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Foreground="White" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="11" Visibility="{Binding Hint, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
