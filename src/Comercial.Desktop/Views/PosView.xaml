<UserControl x:Class="Comercial.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Busca + carrinho -->
        <Grid Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Search" Style="{StaticResource DarkInput}" Height="56" local:Ui.Icon="&#xE721;" FontSize="16"
                             local:Ui.Placeholder="Digite o nome, código ou código de barras do produto..." Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Buscar produto">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Adicionar" Height="56" Width="190" Margin="12,0,0,0" Command="{Binding AddCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Cart}" RowHeight="52" AutomationProperties.Name="Itens da venda">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" Margin="0,0,10,0"/><TextBlock Text="Produto" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15"/>
                                            <TextBlock Text="{Binding PromoText}" Foreground="{DynamicResource PrimaryLightBrush}" FontSize="12" Visibility="{Binding HasPromo, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="#" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="Qtd" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C7;" Margin="0,0,8,0"/><TextBlock Text="Unitário" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Unit}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8EF;" Margin="0,0,8,0"/><TextBlock Text="Total" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Total}" Foreground="White" FontWeight="SemiBold"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE74D;" ToolTip="Remover item" AutomationProperties.Name="Remover item"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vazio -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0" IsHitTestVisible="False"
                                Visibility="{Binding CartEmpty, Converter={StaticResource Vis}}">
                        <Grid Width="150" Height="120" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BF;" FontSize="100" Foreground="{DynamicResource AccentBrush}" Opacity="0.9" HorizontalAlignment="Left"/>
                            <Grid Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Nenhum produto adicionado" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,8"/>
                        <TextBlock Text="Use o campo acima para buscar ou adicionar&#x0a;os produtos do seu catálogo." Style="{StaticResource Muted}" FontSize="15" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sugestões de produtos (sobrepostas ao carrinho) -->
            <Border Grid.Row="1" VerticalAlignment="Top" Margin="6,8,210,0" Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="6"
                    Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
                <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedHit}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Produtos encontrados">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="12,10" CornerRadius="8" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"/>
                                                    <TextBlock Text="{Binding Code}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource WarnBrush}" FontSize="15" Margin="4,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
        </Grid>

        <!-- Painel de pagamento -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,20,8,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <Border Background="{DynamicResource TotalGradientBrush}" CornerRadius="12" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="66" Height="66" Margin="0,0,18,0">
                            <Ellipse Fill="{DynamicResource PrimaryBrush}" Opacity="0.35"/>
                            <Ellipse Margin="8" Fill="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="$" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemsText}" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Total" Foreground="White" FontSize="18"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="38" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cliente (CRM) e pontos de fidelidade -->
                <StackPanel Margin="0,18,0,0" Visibility="{Binding CanUseCustomers, Converter={StaticResource Vis}}">
                    <TextBlock Text="Cliente (opcional)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Grid Visibility="{Binding NoCustomer, Converter={StaticResource Vis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE716;" local:Ui.Placeholder="Nome, CPF ou telefone" Text="{Binding CustomerQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar cliente">
                            <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCustomerCommand}"/></TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE721;" Width="50" Padding="0" Margin="8,0,0,0" Command="{Binding SearchCustomerCommand}" ToolTip="Buscar cliente" AutomationProperties.Name="Buscar cliente"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding CustomerHits}" SelectedItem="{Binding SelectedCustomerHit}" Background="{DynamicResource Surface2Brush}" BorderThickness="0" Margin="0,6,0,0"
                             Visibility="{Binding CustomerHits.Count, Converter={StaticResource Vis}}" AutomationProperties.Name="Clientes encontrados">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,8" Visibility="{Binding HasCustomer, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE711;" Height="30" Padding="6,0" Command="{Binding ClearCustomerCommand}" ToolTip="Remover cliente" AutomationProperties.Name="Remover cliente"/>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE716;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding CustomerText}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Visibility="{Binding CanRedeem, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                        <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE734;" local:Ui.Placeholder="Pontos a usar nesta compra" Text="{Binding Redeem, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pontos a usar"/>
                        <TextBlock Text="{Binding RedeemHint}" Style="{StaticResource Muted}" FontSize="12" Margin="2,4,0,0"/>
                        <TextBlock Text="{Binding LoyaltyText}" Foreground="{DynamicResource WarnBrush}" Margin="2,2,0,0" Visibility="{Binding LoyaltyText, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding PromoSummary}" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="{Binding PromoSummary, Converter={StaticResource Vis}}"/>
                <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE8EC;" local:Ui.Placeholder="Cupom de desconto (opcional)" Margin="0,12,0,0"
                         Text="{Binding Coupon, UpdateSourceTrigger=LostFocus}" CharacterCasing="Upper" AutomationProperties.Name="Cupom de desconto"/>
                <TextBlock Text="Forma de pagamento" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                <ComboBox Style="{StaticResource DarkCombo}" local:Ui.Icon="&#xE8C7;" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding Method}" AutomationProperties.Name="Forma de pagamento">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Valor recebido (R$)" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE8C7;" local:Ui.Placeholder="Vazio = valor que falta" Text="{Binding Paid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor recebido"/>
                    <Button Grid.Column="1" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE710;" Width="50" Padding="0" Margin="8,0,0,0" Command="{Binding AddPaymentCommand}"
                            ToolTip="Dividir: lançar este valor nesta forma e escolher outra para o resto" AutomationProperties.Name="Adicionar outra forma de pagamento"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding PaymentLines}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,4" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE711;" Height="28" Padding="6,0"
                                            Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Remover"/>
                                    <TextBlock Text="{Binding Text}" Foreground="White" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding RemainingText}" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" Visibility="{Binding HasPaymentLines, Converter={StaticResource Vis}}"/>

                <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Finalizar venda (F10)" Height="52" Margin="0,18,0,0" Command="{Binding FinishCommand}"/>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="14,8" Margin="0,14,0,0" Visibility="{Binding HasSaleDiscount, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE711;" Height="30" Padding="6,0" Command="{Binding RemoveDiscountCommand}" ToolTip="Remover desconto" AutomationProperties.Name="Remover desconto"/>
                        <TextBlock Text="{Binding SaleDiscountText}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <UniformGrid Columns="3" Margin="0,12,0,0">
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8A5;" Content="Orçamento" Margin="0,0,6,0" Padding="4,0" Command="{Binding SaveQuoteCommand}"
                            ToolTip="Salvar o carrinho como orçamento"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C7;" Content="Desconto" Margin="0,0,6,0" Command="{Binding DiscountCommand}"
                            ToolTip="Desconto no total da venda (exige autorização do proprietário)"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE74D;" Content="Limpar" Margin="6,0,0,0" Command="{Binding ClearCommand}"/>
                </UniformGrid>
                <Rectangle Height="1" Fill="{DynamicResource DarkBorderBrush}" Margin="0,16"/>
                <TextBlock Text="{Binding StoreText}" Style="{StaticResource Muted}" Margin="0,0,0,8" AutomationProperties.Name="Situação da loja"/>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE719;" Content="Abrir loja" Margin="0,0,5,10" Padding="8,0" Command="{Binding OpenStoreCommand}"
                            ToolTip="Registra a abertura da loja (necessária para abrir o caixa)"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE719;" Content="Fechar loja" Margin="5,0,0,10" Padding="8,0" Command="{Binding CloseStoreCommand}"
                            ToolTip="Só fecha depois que o caixa for fechado"/>
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE8C7;" Content="Abrir caixa" Margin="0,0,5,10" Padding="8,0" Command="{Binding OpenCashCommand}"
                            ToolTip="Só abre com a loja aberta"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72E;" Content="Fechar caixa" Margin="5,0,0,10" Padding="8,0" Command="{Binding CloseCashCommand}"/>
                </UniformGrid>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE710;" Content="Suprimento" Margin="0,0,5,10" Padding="8,0" Command="{Binding SupplyCommand}"
                            ToolTip="Colocar dinheiro na gaveta (reforço de troco)"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE8C7;" Content="Sangria" Margin="5,0,0,10" Padding="8,0" Command="{Binding WithdrawalCommand}"
                            Foreground="{DynamicResource WarnBrush}" ToolTip="Retirada de dinheiro do caixa; o proprietário é avisado"/>
                </UniformGrid>
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE895;" Content="Sincronizar agora" Command="{Binding SyncCommand}"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

