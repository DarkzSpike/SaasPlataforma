<UserControl x:Class="Comercial.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Busca + carrinho -->
        <Grid Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Search" Style="{StaticResource DarkInput}" Height="56" local:Ui.Icon="&#xE721;" FontSize="16"
                             local:Ui.Placeholder="Digite o nome, código ou código de barras do produto..." Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Buscar produto">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE710;" Content="Adicionar" Height="56" Width="190" Margin="12,0,0,0" Command="{Binding AddCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Cart}" RowHeight="52" AutomationProperties.Name="Itens da venda">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7B8;" Margin="0,0,10,0"/><TextBlock Text="Produto" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="#" FontWeight="Bold" Margin="0,0,8,0"/><TextBlock Text="Qtd" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Quantity}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C7;" Margin="0,0,8,0"/><TextBlock Text="Unitário" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Unit}" Foreground="{DynamicResource TextBrush}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8EF;" Margin="0,0,8,0"/><TextBlock Text="Total" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Total}" Foreground="White" FontWeight="SemiBold"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource GhostButton}" local:Ui.Icon="&#xE74D;" ToolTip="Remover item" AutomationProperties.Name="Remover item"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vazio -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50,0,0" IsHitTestVisible="False"
                                Visibility="{Binding CartEmpty, Converter={StaticResource Vis}}">
                        <Grid Width="150" Height="120" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BF;" FontSize="100" Foreground="{DynamicResource AccentBrush}" Opacity="0.9" HorizontalAlignment="Left"/>
                            <Grid Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse Fill="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="22" Foreground="White" HorizontalAlignment="Center"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Nenhum produto adicionado" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,8"/>
                        <TextBlock Text="Use o campo acima para buscar ou adicionar&#x0a;os produtos do seu catálogo." Style="{StaticResource Muted}" FontSize="15" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sugestões de produtos (sobrepostas ao carrinho) -->
            <Border Grid.Row="1" VerticalAlignment="Top" Margin="6,8,210,0" Style="{StaticResource Card}" Background="{DynamicResource Surface2Brush}" Padding="6"
                    Visibility="{Binding HasSuggestions, Converter={StaticResource Vis}}">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45"/></Border.Effect>
                <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedHit}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Produtos encontrados">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="12,10" CornerRadius="8" Background="Transparent">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Price}" Foreground="{DynamicResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15"/>
                                                    <TextBlock Text="{Binding Code}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource WarnBrush}" FontSize="15" Margin="4,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding Status, Converter={StaticResource Vis}}"/>
        </Grid>

        <!-- Painel de pagamento -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,20,8,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>
                <Border Background="{DynamicResource TotalGradientBrush}" CornerRadius="12" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="66" Height="66" Margin="0,0,18,0">
                            <Ellipse Fill="{DynamicResource PrimaryBrush}" Opacity="0.35"/>
                            <Ellipse Margin="8" Fill="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="$" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ItemsText}" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="Total" Foreground="White" FontSize="18"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalText}" Foreground="White" FontSize="38" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Forma de pagamento" Style="{StaticResource SectionTitle}" Margin="0,22,0,10"/>
                <ComboBox Style="{StaticResource DarkCombo}" local:Ui.Icon="&#xE8C7;" ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding Method}" AutomationProperties.Name="Forma de pagamento">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Valor recebido (R$)" Style="{StaticResource SectionTitle}" Margin="0,18,0,10"/>
                <TextBox Style="{StaticResource DarkInput}" local:Ui.Icon="&#xE8C7;" local:Ui.Placeholder="Digite o valor recebido" Text="{Binding Paid, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Valor recebido"/>

                <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Finalizar venda (F10)" Height="52" Margin="0,18,0,0" Command="{Binding FinishCommand}"/>
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE74D;" Content="Limpar" Margin="0,12,0,0" Command="{Binding ClearCommand}"/>
                <Rectangle Height="1" Fill="{DynamicResource DarkBorderBrush}" Margin="0,16"/>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE8C7;" Content="Abrir caixa" Margin="0,0,5,10" Padding="8,0" Command="{Binding OpenCashCommand}"/>
                    <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72E;" Content="Fechar caixa" Margin="5,0,0,10" Padding="8,0" Command="{Binding CloseCashCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE719;" Content="Abrir loja" Margin="0,0,5,10" Padding="8,0" Command="{Binding OpenStoreCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE719;" Content="Fechar loja" Margin="5,0,0,10" Padding="8,0" Command="{Binding CloseStoreCommand}"/>
                </UniformGrid>
                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE895;" Content="Sincronizar agora" Command="{Binding SyncCommand}"/>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

