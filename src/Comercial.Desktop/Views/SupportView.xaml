<UserControl x:Class="Comercial.Desktop.Views.SupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Pedidos de permissão" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Nenhum pedido aguardando sua decisão." Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding NoRequests, Converter={StaticResource Vis}}"/>
                        <ItemsControl ItemsSource="{Binding Requests}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryButton}" Content="Permitir" Padding="14,0" Height="36" Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource DarkButton}" Content="Recusar" Padding="14,0" Height="36" Foreground="{DynamicResource DangerBrush}"
                                                    Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="O que o suporte pode alterar sem pedir a cada vez" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Text="Marque só o que você confia ao suporte. O acesso continua com prazo, exige confirmação em duas etapas do técnico, aparece em Avisos e fica na auditoria. Vendas, caixa e emissão fiscal nunca são liberados."/>
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Checked}" Margin="0,4" Foreground="White" FontSize="15">
                                        <TextBlock Text="{Binding Name}" Foreground="White"/>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AccentButton}" local:Ui.Icon="&#xE74E;" Content="Salvar autorização" HorizontalAlignment="Left" Padding="16,0" Margin="0,12,0,0" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Acessos do suporte" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Encerrar acesso" Padding="14,0" Height="36" Foreground="{DynamicResource DangerBrush}"
                                                Visibility="{Binding Active, Converter={StaticResource Vis}}"
                                                Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
