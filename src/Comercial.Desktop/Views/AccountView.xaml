<UserControl x:Class="Comercial.Desktop.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <Border DockPanel.Dock="Top" Background="#1F1E8CFF" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Info}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Usuário" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding UserEmail}" Foreground="White" FontSize="17" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Verificação em duas etapas" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,6"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Além da senha, o login pede um código que muda a cada 30 segundos no seu celular (Google Authenticator, Microsoft Authenticator ou similar). Recomendado para o dono e gerentes: mesmo que alguém descubra sua senha, não consegue entrar."/>

                        <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE72E;" Content="Ativar verificação em duas etapas" Padding="16,0" Margin="0,16,0,0" HorizontalAlignment="Left"
                                Command="{Binding SetupCommand}" Visibility="{Binding CanStart, Converter={StaticResource Vis}}"/>

                        <StackPanel Visibility="{Binding SettingUp, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="White" CornerRadius="8" Padding="8">
                                    <Image Source="{Binding Qr}" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" MaxWidth="420">
                                    <TextBlock Text="Ou digite esta chave no aplicativo:" Style="{StaticResource Muted}"/>
                                    <TextBox Text="{Binding Secret, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource DarkInput}" FontFamily="Consolas" FontSize="17" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <TextBox Style="{StaticResource DarkInput}" Width="200" MaxLength="6" local:Ui.Icon="&#xE8D7;" local:Ui.Placeholder="Código de 6 dígitos"
                                     Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource PrimaryButton}" local:Ui.Icon="&#xE73E;" Content="Confirmar e ligar" Padding="16,0" Margin="10,0,0,0"
                                    Command="{Binding EnableCommand}" Visibility="{Binding SettingUp, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE711;" Content="Desligar" Padding="16,0" Margin="10,0,0,0"
                                    Command="{Binding DisableCommand}" Visibility="{Binding Enabled, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
