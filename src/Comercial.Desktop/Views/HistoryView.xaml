<UserControl x:Class="Comercial.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Comercial.Desktop">
    <DockPanel>
        <ContentControl DockPanel.Dock="Top" Style="{StaticResource PageHeader}"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE896;" Content="Exportar CSV" Height="36" Command="{Binding ExportCommand}"
                    Visibility="{Binding CanExport, Converter={StaticResource Vis}}"/>
            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextBrush}" FontSize="15" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0" ClipToBounds="True">
                <Grid>
                    <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Sales}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Vendas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data/hora" Binding="{Binding When}" Width="110"/>
                            <DataGridTextColumn Header="Operador" Binding="{Binding Operator}" Width="*"/>
                            <DataGridTextColumn Header="Itens" Binding="{Binding Items}" Width="140"/>
                            <DataGridTextColumn Header="Pagamento" Binding="{Binding Payment}" Width="120"/>
                            <DataGridTemplateColumn Header="Total" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Total}" Foreground="White" FontWeight="SemiBold"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Situação" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2612A86B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Cancelled}" Value="True"><Setter Property="Background" Value="#33F0525F"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Nenhuma venda no período." Style="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <TextBlock Text="Selecione uma venda para ver os itens." Style="{StaticResource Muted}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=not}"/>
                    <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailTitle}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding DetailInfo}" Style="{StaticResource Muted}" Margin="0,6,0,14"/>
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,14,0,0">
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE749;" Content="Reimprimir" Margin="0,0,6,0" Padding="8,0" Command="{Binding ReprintCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE7A7;" Content="Devolver itens" Margin="3,0" Padding="8,0" Command="{Binding ReturnCommand}"/>
                            <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE711;" Content="Cancelar venda" Margin="6,0,0,0" Padding="8,0"
                                    Foreground="{DynamicResource DangerBrush}" Command="{Binding CancelSaleCommand}"/>
                        </UniformGrid>
                        <DataGrid Style="{StaticResource DarkGrid}" ItemsSource="{Binding Detail}" RowHeight="38" AutomationProperties.Name="Itens da venda selecionada">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="60"/>
                                <DataGridTextColumn Header="Unit." Binding="{Binding Unit}" Width="100"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
