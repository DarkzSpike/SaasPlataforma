<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Comercial.Desktop"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Valores padrão; substituídos pela identidade visual publicada da empresa (AppServices.ApplyBranding). -->
    <Color x:Key="PrimaryColor">#12A86B</Color>
    <Color x:Key="PrimaryDarkColor">#0B5C3B</Color>
    <Color x:Key="PrimaryDeepColor">#062F1F</Color>
    <Color x:Key="AccentColor">#1E8CFF</Color>
    <Color x:Key="BgColor">#0B1426</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#12A86B"/>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1BC47D" Offset="0"/><GradientStop Color="#0E8A57" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LoginGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B4A33" Offset="0"/><GradientStop Color="#06291C" Offset="0.6"/><GradientStop Color="#0B5C3B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TotalGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0F6B47" Offset="0"/><GradientStop Color="#0D3B30" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E1A30" Offset="0"/><GradientStop Color="#13274A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#5FD3A0"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#DDF5EA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1E8CFF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#0F2A5C"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F5A524"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F0525F"/>
    <SolidColorBrush x:Key="LightBgBrush" Color="#F1F5F3"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="LightMutedBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="#D7DEE3"/>
    <SolidColorBrush x:Key="LightInputBrush" Color="#F3F5F7"/>
    <SolidColorBrush x:Key="BgBrush" Color="#0B1426"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111D33"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#18253C"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#22314B"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#25344F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#93A0B5"/>
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <sys:Double x:Key="BaseFontSize">14</sys:Double>
    <CornerRadius x:Key="ButtonRadius">8</CornerRadius>
    <sys:String x:Key="SystemName">Gestão Comercial</sys:String>
    <sys:String x:Key="BrandFirst">Gestão </sys:String>
    <sys:String x:Key="BrandLast">Comercial</sys:String>
    <sys:String x:Key="WelcomeMessage">Bem-vindo!</sys:String>

    <local:BoolToVisibility x:Key="Vis"/>
    <local:ToneToBrush x:Key="Tone"/>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
    </Style>

    <!-- Barras de rolagem finas no tema escuro (substituem as claras do Windows) -->
    <ControlTemplate x:Key="ThinThumb" TargetType="Thumb">
        <Border CornerRadius="4" Background="{DynamicResource Surface3Brush}" Margin="2"/>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb><Thumb Template="{StaticResource ThinThumb}"/></Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb><Thumb Template="{StaticResource ThinThumb}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Botões ===== -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ButtonRadius}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Ic" Style="{StaticResource Glyph}" Text="{TemplateBinding local:Ui.Icon}" Margin="0,0,10,0" FontSize="17"/>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:Ui.Icon" Value="">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource PrimaryGradientBrush}"/>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- ===== Campos ===== -->
    <Style x:Key="DarkInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Ic" Style="{StaticResource Glyph}" Text="{TemplateBinding local:Ui.Icon}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="Ph" Grid.Column="1" Text="{TemplateBinding local:Ui.Placeholder}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="local:Ui.Icon" Value="">
                            <Setter TargetName="Ic" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{DynamicResource LightInputBrush}" BorderBrush="{DynamicResource LightBorderBrush}" BorderThickness="1.2" CornerRadius="8">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Glyph}" Text="{TemplateBinding local:Ui.Icon}" Foreground="{DynamicResource LightMutedBrush}" FontSize="18"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightPassword" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource LightTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{DynamicResource LightInputBrush}" BorderBrush="{DynamicResource LightBorderBrush}" BorderThickness="1.2" CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="16,0,48,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox escuro ===== -->
    <Style x:Key="DarkCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Right" Margin="0,0,16,0" Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <StackPanel Orientation="Horizontal" Margin="16,0,40,0" IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Glyph}" Text="{TemplateBinding local:Ui.Icon}" Margin="0,0,12,0" Foreground="{DynamicResource TextBrush}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1" CornerRadius="8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="4">
                                <ItemsPresenter/>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Padding="12,9" CornerRadius="6" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cartões e tabela ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DarkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="DarkGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DarkBorderBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="14,12"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="14,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cabeçalho das páginas do dono (título, período, atualizar, erro) -->
    <Style x:Key="PageHeader" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Margin="0,0,0,18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ListBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" Background="Transparent" BorderThickness="0"
                                         Visibility="{Binding HasPeriod, Converter={StaticResource Vis}}" AutomationProperties.Name="Período">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Padding="14,8" Margin="3,0" CornerRadius="8" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource DarkBorderBrush}" BorderThickness="1">
                                                            <TextBlock x:Name="Tx" Text="{Binding Title}" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Tx" Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <Button Style="{StaticResource DarkButton}" local:Ui.Icon="&#xE72C;" Content="Atualizar" Height="38" Margin="10,0,0,0" Command="{Binding RefreshCommand}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="14"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Carregando..." Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding Loading, Converter={StaticResource Vis}}"/>
                        <Border Background="#33F0525F" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Error}" Foreground="White" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indicador (KPI) -->
    <DataTemplate x:Key="KpiTemplate" DataType="{x:Type local:Kpi}">
        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,16,16" MinWidth="230">
            <StackPanel Orientation="Horizontal">
                <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                    <Ellipse Fill="{Binding Tone, Converter={StaticResource Tone}}" Opacity="0.18"/>
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center" Foreground="{Binding Tone, Converter={StaticResource Tone}}"/>
                </Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="14"/>
                    <TextBlock Text="{Binding Value}" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12.5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Gráfico de barras (vendas x lucro por dia) -->
    <DataTemplate x:Key="BarTemplate" DataType="{x:Type local:Bar}">
        <StackPanel Margin="5,0" VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="160">
                <Rectangle Width="14" Height="{Binding RevenueHeight}" Fill="{DynamicResource AccentBrush}" RadiusX="3" RadiusY="3" VerticalAlignment="Bottom" Margin="0,0,3,0"/>
                <Rectangle Width="14" Height="{Binding ProfitHeight}" Fill="{DynamicResource PrimaryBrush}" RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
